name: snrXvAI-update
  
# Controls when the workflow will run
on:
  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:
    inputs:
      npapers:
        type: number
        default: 1
      ncollabs: 
        type: number
        default: 0

permissions:
  contents: read      # enough for checkout, nothing else

# jobs
jobs:
  build:
    runs-on: ubuntu-26.04
    timeout-minutes: 45
    steps:
      # Checks-out your repository under $GITHUB_WORKSPACE, so your job can access it
      - uses: actions/checkout@v4
        with:
        persist-credentials: false
      - name: Install packages
        run: | 
          sudo apt-get update
          sudo apt-get -y --no-install-recommends install texlive-latex-base texlive-latex-recommended texlive-pictures latexmk ocaml
      - uses: actions/setup-python@v7
        with:
          python-version: '3.13'
      - name: Install requirements
        run: pip install -r requirements.txt
      - name: Look around
        run: | 
          ls -R -I .git
          python --version
          pdflatex --version
          latexmk -v
          ocamlc -version
